# Used by `docker compose` for variable substitution in docker-compose.yml.
# Copy to .env (gitignored) and adjust as needed. Docker Compose loads a
# .env file next to docker-compose.yml automatically — no extra flags needed.
#
# This is separate from backend/.env (the backend's own runtime config,
# loaded into the backend container via env_file) — this one only affects
# how docker-compose.yml itself is interpolated.

# Baked into the frontend's client bundle at build time (see
# frontend/Dockerfile). Must be a URL the *browser* can reach, i.e. the
# backend's published host port below - not the in-network "backend" name.
NEXT_PUBLIC_API_BASE=http://localhost:5000/api

# Host ports, if 3000/5000 are already taken locally.
# BACKEND_PORT=5000
# FRONTEND_PORT=3000
